export const prerender = true;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Volodymyr Kaidun</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body {
        height: 100%;
        background: #0f0f0f;
        color: #f0ede8;
        font-family: system-ui, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .card {
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      h1 { font-size: 1.8rem; font-weight: 600; }
      p { color: #888; font-size: 1rem; }
      a { color: #888; text-decoration: none; }
      a:hover { color: #f0ede8; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Volodymyr Kaidun</h1>
      <p>Design Director</p>
      <a href="mailto:vkaidun@gmail.com">vkaidun@gmail.com</a>
    </div>
  </body>
</html>
