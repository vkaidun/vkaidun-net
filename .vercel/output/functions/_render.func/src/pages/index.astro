---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const hero = await reader.singletons.hero.read();
const services = await reader.singletons.services.read();
const howItWorks = await reader.singletons.howItWorks.read();
const footer = await reader.singletons.footer.read();
---
<Layout>
  <header>
    <a href="/" class="logo">vkaidun</a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-photo">
        <img src="/images/vova.jpg" alt="Vova Kaidun" />
      </div>
      <div class="hero-text">
        <h1>{hero?.title}</h1>
        <p>{hero?.description}</p>
        <div class="social-links">
          {hero?.linkedinUrl && <a href={hero.linkedinUrl} target="_blank" rel="noopener">LinkedIn</a>}
          {hero?.portfolioUrl && <a href={hero.portfolioUrl} target="_blank" rel="noopener">Portfolio</a>}
          {hero?.behanceUrl && <a href={hero.behanceUrl} target="_blank" rel="noopener">Behance</a>}
        </div>
      </div>
    </section>

    <section class="services">
      <h2>{services?.sectionTitle}</h2>
      <div class="services-grid">
        {services?.items.map((item) => (
          <div class="service-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="how-it-works">
      <h2>{howItWorks?.sectionTitle}</h2>
      <p>{howItWorks?.content}</p>
    </section>

    <section class="contact">
      <p class="charity">{footer?.charityText}</p>
      <a href={`mailto:${footer?.contactEmail}`} class="contact-btn">Get in touch</a>
    </section>
  </main>

  <footer>
    <span>© {new Date().getFullYear()} Vova Kaidun</span>
  </footer>
</Layout>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 10;
  }
  .logo {
    font-weight: 600;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--text);
    letter-spacing: 0.02em;
  }

  main { max-width: 900px; margin: 0 auto; padding: 0 2rem; }

  .hero {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    align-items: center;
    padding: 5rem 0 4rem;
  }
  .hero-photo {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: var(--card-bg);
    overflow: hidden;
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero h1 {
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1rem;
    color: var(--text);
  }
  .hero p {
    color: var(--muted);
    font-size: 1.05rem;
    margin-bottom: 1.5rem;
  }
  .social-links { display: flex; gap: 1rem; flex-wrap: wrap; }
  .social-links a {
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--border);
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    font-size: 0.9rem;
    transition: border-color 0.2s;
  }
  .social-links a:hover { border-color: var(--accent); }

  .services { padding: 4rem 0; border-top: 1px solid var(--border); }
  .services h2, .how-it-works h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 2rem;
    color: var(--accent);
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .service-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
  }
  .service-card h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .service-card p { color: var(--muted); font-size: 0.9rem; line-height: 1.5; }

  .how-it-works {
    padding: 4rem 0;
    border-top: 1px solid var(--border);
  }
  .how-it-works p {
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 640px;
    line-height: 1.7;
  }

  .contact {
    padding: 4rem 0;
    border-top: 1px solid var(--border);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }
  .charity { color: var(--muted); font-size: 1rem; }
  .contact-btn {
    display: inline-block;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
    padding: 0.8rem 2rem;
    border-radius: 2rem;
    font-weight: 600;
    font-size: 1rem;
    transition: opacity 0.2s;
  }
  .contact-btn:hover { opacity: 0.85; }

  footer {
    border-top: 1px solid var(--border);
    padding: 2rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .hero { grid-template-columns: 1fr; text-align: center; padding: 3rem 0 2rem; }
    .hero-photo { margin: 0 auto; }
    .social-links { justify-content: center; }
    .hero h1 { font-size: 1.4rem; }
  }
</style>
